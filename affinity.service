[Unit]
Description=Remove legacy display_connector affinity tuning (one-time migration)

# affinity.service is retired. Installed display.service units from earlier
# releases still install and enable this unit from the repo on startup, so it
# stays as a shim that removes itself and the legacy tuning, then never runs again.
After=display.service

[Service]
Type=oneshot
ExecStart=/home/mks/display_connector/affinity-setup.sh

[Install]
WantedBy=display.service
